@model  PegawaiMVC.Models.Pegawai

<h2>Edit Pegawai</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id"/>
    <div class="form-group">
        <label>Nama</label>
        <input asp-for="Nama" class="form-control"/>
    </div>

    <div class="form-group">
        <label>Jenis Kelamin</label>
        <select asp-for="JenisKelamin" class="form-control">
            <option value="">-- Pilih --</option>
            <option value="Laki-laki">Laki-laki</option>
            <option value="Perempuan">Perempuan</option>
        </select>
    </div>

    <div class="form-group">
        <label>Alamat</label>
        <input asp-for="Alamat" class="form-control"/>
    </div>

    <div class="form-group">
        <label>Jabatan</label>
        <input asp-for="Jabatan" class="form-control"/>
    </div>

    <div class="form-group">
        <label>Gaji</label>
        <input asp-for="Gaji" class="form-control"/>
    </div>
    
    <div class="form-group">
        <label asp-for="TanggalLahir"></label>
        <input asp-for="TanggalLahir" class="form-control" type="date"/>
    </div>

    <div class="form-group">
        <label asp-for="TanggalMasukKerja"></label>
        <input asp-for="TanggalMasukKerja" class="form-control" type="date"/>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>