@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Dashboard Pegawai</h2>

    <div class="row justify-content-center">
        <!-- Card Laki-laki -->
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3 shadow">
                <div class="card-header text-center">Pegawai Laki-laki</div>
                <div class="card-body text-center">
                    <h3>@ViewBag.JumlahLaki</h3>
                </div>
            </div>
        </div>

        <!-- Card Perempuan -->
        <div class="col-md-4">
            <div class="card text-white bg-pink mb-3 shadow" style="background-color:#e83e8c;">
                <div class="card-header text-center">Pegawai Perempuan</div>
                <div class="card-body text-center">
                    <h3>@ViewBag.JumlahPerempuan</h3>
                </div>
            </div>
        </div>
    </div>
</div>
